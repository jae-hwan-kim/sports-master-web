# 로컬 개발 빌드(시뮬레이터/공기계 확인)에서는 Sentry 조직/프로젝트 인증 정보가 없어
# "Upload Debug Symbols to Sentry" 빌드 스크립트가 실패함 — 소스맵 업로드를 건너뛰도록 비활성화
SENTRY_DISABLE_AUTO_UPLOAD=true

# 소셜 로그인 — Google Cloud Console(OAuth 클라이언트)
# iOS: iOS 유형 클라이언트 ID (Bundle ID: sports.master) — idToken의 aud 값
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android: 네이티브 SDK가 Web 유형 클라이언트 ID로 idToken을 발급받는다(aud = 이 값).
# Android 유형 클라이언트(패키지명 + debug/release SHA-1)는 콘솔에만 등록되어 있으면 되고
# 앱 코드에서 직접 참조하지 않는다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# 카카오 개발자 콘솔(REST API 키)
EXPO_PUBLIC_KAKAO_REST_API_KEY=
# 카카오 콘솔의 Redirect URI 및 백엔드 .env의 KAKAO_REDIRECT_URI와 반드시 동일해야 함
EXPO_PUBLIC_KAKAO_REDIRECT_URI=
