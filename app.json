{
  "expo": {
    "name": "sports-master",
    "slug": "sports-master",
    "version": "1.0.0",
    "scheme": "sportsmaster",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sports.master",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.26841070939-t19a28k7ecdhnggdefacfqrbf7nsbkpo"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "sports.master",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "com.googleusercontent.apps.26841070939-1fgiabcvk1kb27vo1a6hhjfmo3a4h2iv" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@sentry/react-native",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "자격증 이미지를 첨부하려면 사진 접근 권한이 필요합니다."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1a97c81a-484d-4067-bfff-6f5674313b98"
      }
    }
  }
}
